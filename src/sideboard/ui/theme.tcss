/* Sideboard — semantic tokens only. No feature colours in core styles. */

Screen {
    background: $background;
    color: $foreground;
}

#sb-tabbar {
    height: 1;
    background: $background;
    color: $sb-dim;
    padding: 0 1;
}

#sb-body {
    height: 1fr;
}

#sb-footer {
    height: 1;
    background: $background;
    color: $sb-dim;
    padding: 0 1;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    height: 1;
    background: $background;
}

Tab {
    color: $sb-dim;
    padding: 0 2;
    background: $background;
}

Tab.-active {
    color: $foreground;
    text-style: bold;
}

/* The whole chain must be given a height: Textual's defaults for these three are
   `height: auto`, and an `auto` container cannot give a `1fr` child any space — the
   tab body silently collapses to zero rows. */
TabbedContent > ContentSwitcher {
    height: 1fr;
    background: $background;
}

TabPane {
    padding: 0;
    height: 1fr;
    background: $background;
}

/* A tab body: an overview grid, a stack of cards, or a filterable read view. */
.sb-pane {
    height: 1fr;
    width: 1fr;
}

/* Subfilter row for the Read tab. It must be exactly one row: an unconstrained
   widget in a tab competes with the pane for the fraction space and can leave the
   cards with zero height. */
FilterBar {
    height: 1;
    padding: 0 1;
    background: $background;
}

FilterBar:focus {
    background: $panel;
}

/* -------------------------------------------------------------------------------- card shell */

CardShell {
    border: round $sb-border;
    background: $surface;
    padding: 0 1;
    height: 1fr;
    width: 1fr;
}

/* The card the keyboard is on: the only card with a bright border and a lifted
   background. Pinned cards are marked by the diamond in their title, not by a colour that
   also means "the pointer is over this" or "the keyboard is here". */
CardShell:focus {
    border: round $sb-focus;
    background: $sb-focus-bg;
}

/* Held: the pointer is over it, or it was just interacted with. Deliberately quieter
   than focus so the two can never be confused. */
CardShell.sb-held {
    border: round $sb-border-held;
}

CardShell.sb-selected {
    border: heavy $sb-border-focus;
}

CardShell.sb-pinned {
    border: round $sb-border;
}

CardShell.sb-minimal {
    border: none;
    padding: 0;
}

/* ------------------------------------------------------------------ overview */

#sb-overview-grid {
    height: 1fr;
}

#sb-overview-rows {
    height: 1fr;
}

.sb-overview-row {
    height: 1fr;
}

/* -------------------------------------------------------------------- layout */

/* A stack of cards scrolls: with several widgets on one tab, slicing the viewport
   evenly would give each card a border and one line. Each card keeps at least eight
   content rows, and the pane scrolls (mouse wheel, PgUp/PgDn, Home/End). */
.sb-stack {
    height: 1fr;
    overflow-y: auto;
}

/* Card heights in a stack are set by DetailPane.apply_heights: an explicit row count
   per card, so a tab with several widgets stays readable and scrolls. */
.sb-stack > CardShell {
    margin-bottom: 0;
}

.sb-grid {
    height: 1fr;
    overflow-y: auto;
}

.sb-overview-row > CardShell {
    height: 1fr;
    min-height: 10;
}

.sb-compact-status {
    padding: 1 2;
    color: $sb-dim;
}

DataTable {
    background: $surface;
}

DataTable > .datatable--header {
    background: $panel;
    color: $sb-dim;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $boost;
}

DataTable > .datatable--hover {
    background: $boost;
}

Footer {
    background: $background;
    color: $sb-dim;
}

ModalScreen {
    background: $background 60%;
}

#sb-detail {
    border: round $sb-border-focus;
    background: $surface;
    padding: 1 2;
    height: 80%;
    width: 90%;
}

#sb-help {
    border: round $sb-border;
    background: $surface;
    padding: 1 2;
    height: auto;
    max-height: 80%;
    width: 80%;
}

/* ------------------------------------------------------------------- mouse map */

DiagnosticScreen {
    background: $background;
}

.mouse-cell {
    border: round $sb-border;
    padding: 1 2;
}
