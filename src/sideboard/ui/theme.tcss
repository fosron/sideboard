/* Sideboard — semantic tokens only. No feature colours in core styles. */

Screen {
    background: $background;
    color: $foreground;
}

/* Textual gives every widget a two-cell scrollbar in a bright ansi colour; on a dark
   dashboard that is a wide, jagged stripe. One cell, in the palette's quiet tones: the
   size is a style, not a theme variable, so it is set here. */
Widget {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

#sb-body {
    height: 1fr;
}

/* One bar at the bottom: what this is and when it was last refreshed on the left, where
   the keys are on the right. It carries a panel background so it reads as chrome rather
   than as a stray line of text on the screen. */
#sb-footer {
    height: 1;
    background: $panel;
    color: $sb-dim;
    padding: 0 1;
}

#sb-footer-status {
    width: 1fr;
    background: $panel;
    color: $sb-dim;
}

#sb-footer-help {
    width: auto;
    background: $panel;
    color: $sb-dim;
    text-align: right;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    height: 1;
    background: $background;
}

Tab {
    color: $sb-dim;
    /* One cell of padding per side instead of two: at the documented 60-column minimum
       six tabs already used 57 of 60 cells, so a seventh was clipped rather than shown. */
    padding: 0 1;
    background: $background;
}

Tab.-active {
    color: $foreground;
    text-style: bold;
}

/* The whole chain must be given a height: Textual's defaults for these three are
   `height: auto`, and an `auto` container cannot give a `1fr` child any space — the
   tab body silently collapses to zero rows. */
TabbedContent > ContentSwitcher {
    height: 1fr;
    background: $background;
}

TabPane {
    padding: 0;
    height: 1fr;
    background: $background;
}

/* A tab body: an overview grid, a stack of cards, or a filterable read view. */
.sb-pane {
    height: 1fr;
    width: 1fr;
}

/* Subfilter row for the Read tab. It must be exactly one row: an unconstrained
   widget in a tab competes with the pane for the fraction space and can leave the
   cards with zero height. */
FilterBar {
    height: 1;
    padding: 0 1;
    background: $background;
}

FilterBar:focus {
    background: $panel;
}

/* -------------------------------------------------------------------------------- card shell */

CardShell {
    border: round $sb-border;
    border-title-color: $sb-value;
    border-subtitle-color: $sb-dim;
    background: $surface;
    padding: 0 1;
    height: 1fr;
    width: 1fr;
}

/* Held: the pointer is over it, or it was just interacted with. Deliberately quieter
   than focus so the two can never be confused. */
CardShell.sb-held {
    border: round $sb-border-held;
}

/* Pinned is marked by the diamond in the title, not by a border colour that also means
   "the pointer is over this" or "the keyboard is here". */
CardShell.sb-pinned {
    border: round $sb-border;
}

/* The card the keyboard is on. A mid blue border plus the ▸ marker in the title — not the
   brightest colour on screen: severity owns that channel, so a failing card outshines the
   cursor. The former lifted background measured 1.15:1 against the surface, which is not a
   signal, so it is gone. Declared last, and repeated for the state classes, because a class
   rule of equal specificity that comes later wins. */
CardShell:focus,
CardShell.sb-held:focus,
CardShell.sb-pinned:focus {
    border: round $sb-border-focus;
}

/* Data that is not fresh: the values are drawn muted and the timestamp carries the warning
   tone, so a stale card cannot be read as a current one from across a room. */
CardShell.sb-stale {
    border-subtitle-color: $sb-warn;
}

CardShell.sb-minimal {
    border: none;
    padding: 0;
}

/* ------------------------------------------------------------------ overview */

#sb-overview-grid {
    height: 1fr;
}

#sb-overview-rows {
    height: 1fr;
}

.sb-overview-row {
    height: 1fr;
}

/* -------------------------------------------------------------------- layout */

/* A stack of cards scrolls: with several widgets on one tab, slicing the viewport
   evenly would give each card a border and one line. Each card keeps at least eight
   content rows, and the pane scrolls (mouse wheel, PgUp/PgDn, Home/End). */
.sb-stack {
    height: 1fr;
    overflow-y: auto;
}

/* Card heights in a stack are set by DetailPane.apply_heights: an explicit row count
   per card, so a tab with several widgets stays readable and scrolls. */
.sb-stack > CardShell {
    margin-bottom: 0;
}

.sb-grid {
    height: 1fr;
    overflow-y: auto;
}

.sb-overview-row > CardShell {
    height: 1fr;
    min-height: 10;
}

.sb-compact-status {
    padding: 1 2;
    color: $sb-dim;
}

DataTable {
    background: $surface;
}

DataTable > .datatable--header {
    background: $panel;
    color: $sb-dim;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $boost;
}

DataTable > .datatable--hover {
    background: $boost;
}

Footer {
    background: $background;
    color: $sb-dim;
}

ModalScreen {
    background: $background 60%;
}

/* Modals are centred with a margin all round: the dimmed edge is what the user clicks to
   close them, so it has to exist on every side. */
ModalScreen {
    align: center middle;
}

#sb-detail {
    border: round $sb-border-focus;
    background: $surface;
    padding: 1 2;
    height: 80%;
    width: 90%;
}

#sb-help {
    border: round $sb-border;
    background: $surface;
    padding: 1 2;
    height: auto;
    max-height: 80%;
    width: 80%;
}

/* ------------------------------------------------------------------- mouse map */

DiagnosticScreen {
    background: $background;
}

.mouse-cell {
    border: round $sb-border;
    padding: 1 2;
}
